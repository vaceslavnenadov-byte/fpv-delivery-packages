# Манифест системных пакетов Debian 13 (trixie) для платформы FPV.
# Формат: <группа узлов>  <пакет>  <ограничение версии>
# Пакеты устанавливаются из подписанных репозиториев Debian (или внутреннего зеркала ЦОД,
# синхронизированного с ними). Дублирование .deb в репозитории не выполняется.
# Ограничения заданы по основной версии ветки trixie; точное соответствие зеркалу
# проверяется scripts/check-debian13.sh до публикации тега.
all                 ca-certificates              >= 20250419
all                 python3                      >= 3.13.5, << 3.14
all                 python3-venv                 >= 3.13.5, << 3.14
all                 python3-apt                  >= 3.0
all                 acl                          >= 2.3.2
all                 chrony                       >= 4.6
all                 rsync                        >= 3.4
all                 curl                         >= 8.14
all                 gnupg                        >= 2.4
all                 auditd                       >= 1:4.0
all                 unattended-upgrades          >= 2.12
all                 procps                       >= 2:4.0
all                 sudo                         >= 1.9.16
all                 openssh-server               >= 1:10.0p1
all                 rsyslog                      >= 8.2504
all                 rsyslog-gnutls               >= 8.2504
all                 logrotate                    >= 3.22
all                 prometheus-node-exporter     >= 1.9
domain_sssd         realmd                       >= 0.17
domain_sssd         sssd                         >= 2.10, << 2.11
domain_sssd         sssd-tools                   >= 2.10, << 2.11
domain_sssd         adcli                        >= 0.9.2
domain_sssd         krb5-user                    >= 1.21
domain_sssd         libnss-sss                   >= 2.10
domain_sssd         libpam-sss                   >= 2.10
domain_sssd         samba-common-bin             >= 2:4.22
domain_sssd         packagekit                   >= 1.3
file_servers        samba                        >= 2:4.22, << 2:4.23
file_servers        winbind                      >= 2:4.22, << 2:4.23
file_servers        libnss-winbind               >= 2:4.22
file_servers        libpam-winbind               >= 2:4.22
file_servers        attr                         >= 1:2.5
file_servers        smbclient                    >= 2:4.22
workstations        cifs-utils                   >= 2:7.2
workstations        keyutils                     >= 1.6.3
