# Манифест системных пакетов Debian 11 (bullseye) для платформы FPV.
# Формат: <группа узлов>  <пакет>  <ограничение версии>
# Пакеты устанавливаются из подписанных репозиториев Debian (или внутреннего зеркала ЦОД,
# синхронизированного с ними). Дублирование .deb в репозитории не выполняется.
# Ограничения проверены по составу bullseye / bullseye-security на дату релиза (см. CHANGELOG).
all                 ca-certificates              >= 20210119
all                 python3                      >= 3.9.2, << 3.10
all                 python3-venv                 >= 3.9.2, << 3.10
all                 python3-apt                  >= 2.2
all                 acl                          >= 2.2.53
all                 chrony                       >= 4.0
all                 rsync                        >= 3.2.3
all                 curl                         >= 7.74
all                 gnupg                        >= 2.2.27
all                 auditd                       >= 1:3.0
all                 unattended-upgrades          >= 2.8
all                 apt-transport-https          >= 2.2
all                 sudo                         >= 1.9.5p2
all                 openssh-server               >= 1:8.4p1
all                 rsyslog                      >= 8.2102
all                 rsyslog-gnutls               >= 8.2102
all                 logrotate                    >= 3.18
all                 prometheus-node-exporter     >= 1.1.2
